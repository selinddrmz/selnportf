
"use client";

import { useState } from "react";

export default function GalleryActions({
  id,
  yayinda,
}: {
  id: number;
  yayinda: boolean;
}) {
  const [isPublished, setIsPublished] = useState(yayinda);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  async function togglePublished() {
    setLoading(true);
    setError("");

    try {
      const response = await fetch("/api/admin-gallery", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id }),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || "İşlem başarısız.");
      }

      setIsPublished(data.yayinda);
    } catch (err) {
      setError(err instanceof Error ? err.message : "Bir hata oluştu.");
    } finally {
      setLoading(false);
    }
  }

  return (
    <div>
      <button
        type="button"
        onClick={togglePublished}
        disabled={loading}
        style={{
          padding: "8px 12px",
          border: "1px solid #493052",
          borderRadius: "8px",
          background: isPublished ? "#493052" : "#f04bd8",
          color: "#fff",
          cursor: loading ? "wait" : "pointer",
        }}
      >
        {loading ? "İşleniyor..." : isPublished ? "Yayından kaldır" : "Yayına al"}
      </button>
      {error && <p style={{ color: "#ff8c8c" }}>{error}</p>}
    </div>
  );
}
